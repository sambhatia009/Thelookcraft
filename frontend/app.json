{
  "expo": {
    "name": "TheLookCraft",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.stylevaultapp.maauzy",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of your clothes to add them",
        "NSPhotoLibraryUsageDescription": "Add clothing photos from your gallery",
        "NSLocationWhenInUseUsageDescription": "Match outfits to your local weather",
        "NSPhotoLibraryAddUsageDescription": "Save your outfit cards to Photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.stylevaultapp.maauzy",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Add clothing photos from your gallery",
          "cameraPermission": "Take photos of your clothes to add them"
        }
      ],
      "expo-camera",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Match outfits to your local weather"
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Save your outfit cards to Photos",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
